# Server
NODE_ENV=development
PORT=4000

# CORS: cho phép nhiều origin, phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Auth — JWT_SECRET BẮT BUỘC đổi khi production (>= 32 ký tự)
JWT_SECRET=dev-only-secret-change-me-before-production!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
