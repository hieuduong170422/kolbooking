# Server
NODE_ENV=development
PORT=4000

# CORS: cho phép nhiều origin, phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
# Giới hạn chung mỗi IP. Client có polling nên đừng để thấp: một phiên dùng
# bình thường đã vài chục request/phút.
RATE_LIMIT_MAX=300
# Mặc định true. Script `npm run dev` tự đặt false vì e2e chạy 3 phiên song
# song sẽ vượt ngưỡng. KHÔNG đặt false ở môi trường thật.
RATE_LIMIT_ENABLED=true
# Giới hạn cho login/register/OTP/reset password — luôn bật kể cả ở dev.
AUTH_RATE_LIMIT_MAX=10

# Auth — JWT_SECRET BẮT BUỘC đổi khi production (>= 32 ký tự)
# Sinh khóa: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-before-production!
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Mã OTP cố định cho môi trường chưa có SMTP (mailer hiện chỉ in mã ra log).
# Đặt 6 chữ số, ví dụ 111111, là mọi mã cấp ra đều bằng giá trị đó — nhập tay
# được, khỏi mò trong log. Chỉ thay khâu sinh mã: hạn dùng, giới hạn nhập sai
# và luật dùng-một-lần vẫn nguyên. Server TỪ CHỐI khởi động nếu bật ở
# production, vì mã đoán được là chiếm được tài khoản qua luồng quên mật khẩu.
DEV_OTP_CODE=

# Cờ Secure của cookie refresh. Bỏ trống = theo NODE_ENV (production bật).
# Đặt false khi chạy HTTP trần trên IP (chưa có domain/HTTPS): trình duyệt
# loại bỏ cookie Secure trên http://, phiên đăng nhập sẽ chết sau 15 phút.
# Có domain + HTTPS rồi thì XÓA dòng này đi.
COOKIE_SECURE=

# Database — bỏ trống = chạy in-memory (dev/test), MẤT SẠCH dữ liệu khi restart.
# Có giá trị = dùng PostgreSQL, schema tự áp lúc khởi động.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Thư mục bản build của client (đường dẫn tương đối tính từ server/). Có giá
# trị thì chính API phục vụ luôn giao diện — một tiến trình chạy được cả web
# lẫn API, không cần nginx đứng trước. Bỏ trống thì API chỉ phục vụ /api.
# Ví dụ: SERVE_CLIENT_DIR=../client/dist
SERVE_CLIENT_DIR=

# Nạp dữ liệu demo (tài khoản demo dùng chung mật khẩu công khai, creator,
# package mẫu) khi database còn rỗng. Ngoài production luôn nạp.
# ĐẶT false trước khi có người dùng thật — nếu không mật khẩu demo là cửa sau.
SEED_DEMO_DATA=false

# Mật khẩu cho bộ tài khoản demo. Bỏ trống → dùng mật khẩu dev công khai
# (Demo@1234), chỉ chấp nhận được ở máy local. Bật SEED_DEMO_DATA ở production
# mà để trống dòng này thì server TỪ CHỐI khởi động.
DEMO_SEED_PASSWORD=
